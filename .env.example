# Public origin of the site (no trailing slash). Required on the production deployment.
SITE_URL=http://localhost:3000

# Set to 1 to make unresolved `needsReview` content fail the build locally.
# Always on for the production deployment.
CONTENT_STRICT=0

# Contact form delivery (Resend). Without RESEND_API_KEY the form reports that it could not send.
RESEND_API_KEY=
# Verified sender, e.g. "Portfolio <hello@your-domain.com>"
CONTACT_FROM=
# Where messages go. Defaults to the email address in content/site.ts.
CONTACT_TO=
